# Publish only maintained source and replication instructions. Everything else,
# including existing research evidence, remains local and is never deleted.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY.md
!/.github/
!/.github/**
!/docs/
!/docs/**
!/replication/
!/replication/**
!/host-tools/
/host-tools/*
!/host-tools/ResearchOperator.ps1
!/host-tools/ResearchOperator.cmd
!/host-tools/ResearchOperator.py
!/host-tools/ResearchPaths.py
!/host-tools/Resolve-ResearchPython.ps1
!/host-tools/SetupResearch.ps1
!/host-tools/PrepareResearchVM.py
!/host-tools/Check-ResearchHost.ps1
!/host-tools/RunQemuResearch.py
!/host-tools/FreezePilotSource.py
!/host-tools/ReportQemuPilot.py
!/host-tools/WatchResearch.py
!/host-tools/WatchCommittedSignals.py
!/host-tools/TestResearchOperator.py
!/host-tools/TestReplication.py
!/phishing-study/
/phishing-study/*
!/phishing-study/pyproject.toml
!/phishing-study/Dockerfile
!/phishing-study/study/
!/phishing-study/study/**
!/phishing-study/scripts/
!/phishing-study/scripts/**
!/phishing-study/tests/
!/phishing-study/tests/**
!/phishing-study/configs/
!/phishing-study/configs/**
!/phishing-study/deployment/
/phishing-study/deployment/*
!/phishing-study/deployment/linux/
!/phishing-study/deployment/linux/**
!/phishing-study/deployment/fixtures/
!/phishing-study/deployment/fixtures/Dockerfile
**/__pycache__/
**/*.pyc
**/*.pem
**/*.key
**/.env
**/.env.*
**/id_ed25519*
**/id_rsa*
**/operator_key*
**/known_hosts*
**/*.sqlite*
**/*.qcow2
**/*.raw
**/*.iso
**/*.img
**/*.tar.gz
**/*.zip
**/*.egg-info/
